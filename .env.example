# File: .env.example
# ==============================================================================
# AI/ML Lab Environment Configurations
# Copy this file to '.env' and modify as needed.
# ==============================================================================

# Security token for JupyterLab (leave blank for no token, but recommended)
JUPYTER_TOKEN=antigravity

# Internal and External MLflow configuration
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# JupyterLab Port configuration for each lab
BASIC_ML_PORT=8888
DEEP_ML_PORT=8889
FASTAI_PORT=8893
NLP_PORT=8890
CV_PORT=8891
RL_PORT=8892

# PyTorch/TensorFlow settings
CUDA_VISIBLE_DEVICES=0
